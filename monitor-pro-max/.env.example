# ============================================================
# ADF-ADB Monitor Pro Max - Environment configuration
# Copy this file to `.env` and fill in your real credentials.
# ============================================================

# ---- LLM provider selection ----
# Choose which provider the diagnostic agent should use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# ---- Anthropic (Claude 3.5 Sonnet) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- OpenAI (GPT-4o) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ---- Telemetry source (optional overrides) ----
# Path to the directory holding mock/real telemetry dumps.
TELEMETRY_DIR=mock_telemetry

# ============================================================
# LIVE INTEGRATION PLACEHOLDERS (currently offline / mock only)
# Fill these in when wiring up real ADF + Databricks ingestion.
# ============================================================

# ---- Azure Data Factory ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
ADF_FACTORY_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Azure Databricks ----
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxx
